    When I press "Ctrl+S"
    Then I collect JSON artifact "unresolved-legacy-saved-file" from extension host expression "(async () => { const uri = globalThis.__unresolvedLegacyUri; const deadline = Date.now() + 10000; while (Date.now() < deadline) { const document = vscode.workspace.textDocuments.find(candidate => candidate.uri.toString() === uri?.toString()); if (document && !document.isDirty) { const text = new TextDecoder().decode(await vscode.workspace.fs.readFile(uri)); const file = JSON.parse(text); const section = file.state.sections.find(entry => entry.id === 'query_legacy_migration'); const chart = file.state.sections.find(entry => entry.id === 'chart_legacy_migration'); if (section?.resultJson === globalThis.__unresolvedLegacyResultJson && section.kustoAccountPartition === undefined && section.kustoLeaveNoTraceRevision === undefined && section.resultArtifact === undefined && chart?.chartTitle === 'Unresolved legacy saved' && chart?.mode === 'preview') return { payloadStable: true, markerless: true, descriptorRemoved: true, chartTitle: chart.chartTitle, mode: chart.mode, dirty: document.isDirty }; } await new Promise(resolve => setTimeout(resolve, 100)); } throw new Error('Saved unresolved legacy state did not settle'); })()"
