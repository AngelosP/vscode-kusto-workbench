Feature: Unresolved legacy Kusto result visibility

  Background:
    Given the extension is in a clean state
    When I move the Dev Host to 0, 0
    And I resize the Dev Host to 1280x1000
    And I execute command "workbench.action.closeAuxiliaryBar"

  Scenario: Markerless result remains visible and exact through edit, Save, and reopen
    When I execute command "kustoWorkbench.test.cleanupPersistedResultFixture"
    Then I collect JSON artifact "unresolved-legacy-prepared" from extension host expression "(async () => { const extension = vscode.extensions.getExtension('angelos-petropoulos.vscode-kusto-workbench'); if (!extension) throw new Error('Kusto Workbench extension unavailable'); const template = vscode.Uri.joinPath(extension.extensionUri, 'tests', 'vscode-extension-tester', 'e2e', 'default', 'legacy-result-migration', 'fixtures', 'legacy-chart-ragged.kqlx'); const directory = vscode.Uri.joinPath(extension.extensionUri, 'tests', 'vscode-extension-tester', 'runs', 'default', 'legacy-unresolved-result'); const output = vscode.Uri.joinPath(directory, 'unresolved-legacy-' + Date.now() + '.kqlx'); const bytes = await vscode.workspace.fs.readFile(template); await vscode.workspace.fs.createDirectory(directory); await vscode.workspace.fs.writeFile(output, bytes); globalThis.__unresolvedLegacyUri = output; return { copiedBytes: bytes.byteLength, filename: output.path.split('/').pop(), ownerPrepared: false }; })()"
    Then I collect JSON artifact "unresolved-legacy-baseline" from extension host expression "(async () => { const uri = globalThis.__unresolvedLegacyUri; if (!uri) throw new Error('Unique unresolved legacy URI was not prepared'); const text = new TextDecoder().decode(await vscode.workspace.fs.readFile(uri)); const section = JSON.parse(text).state.sections.find(entry => entry.id === 'query_legacy_migration'); const result = section?.resultJson ? JSON.parse(section.resultJson) : undefined; if (!section?.resultJson || result?.rows?.some(row => row.length !== 3) || section.kustoAccountPartition !== undefined || section.kustoLeaveNoTraceRevision !== undefined || section.resultArtifact?.policy?.exportToCsv !== true || section.resultArtifact?.policy?.exposeToActiveContent !== true) throw new Error('Unresolved legacy baseline is not ragged, markerless, and privileged: ' + JSON.stringify(section)); globalThis.__unresolvedLegacyResultJson = section.resultJson; return { bytes: text.length, markerless: true, hasResult: true, privilegedDescriptor: true, persistedRowWidths: result.rows.map(row => row.length) }; })()"
    Then I collect JSON artifact "unresolved-legacy-opened" from extension host expression "(async () => { const uri = globalThis.__unresolvedLegacyUri; if (!uri) throw new Error('Unique unresolved legacy URI was not prepared'); await vscode.commands.executeCommand('vscode.openWith', uri, 'kusto.kqlxEditor'); return { opened: true, filename: uri.path.split('/').pop() }; })()"
    When I wait for "kw-query-section" in the webview for 20 seconds
    Then I collect JSON artifact "unresolved-legacy-host-startup" from extension host expression "(async () => { await new Promise(resolve => setTimeout(resolve, 2000)); const uri = globalThis.__unresolvedLegacyUri; const document = vscode.workspace.textDocuments.find(candidate => candidate.uri.toString() === uri?.toString()); const buffer = document ? JSON.parse(document.getText()) : undefined; const disk = uri ? JSON.parse(new TextDecoder().decode(await vscode.workspace.fs.readFile(uri))) : undefined; return { dirty: document?.isDirty ?? null, bufferHasResult: !!buffer?.state?.sections?.find(section => section.id === 'query_legacy_migration')?.resultJson, diskHasResult: !!disk?.state?.sections?.find(section => section.id === 'query_legacy_migration')?.resultJson }; })()"
    When I evaluate "(() => { if (!window.__e2e?.workbench) throw new Error('Workbench E2E bridge unavailable'); return window.__e2e.workbench.waitForPersistedResult('query_legacy_migration', 19000); })()" in the webview for 20 seconds
    Then I collect JSON artifact "unresolved-legacy-first-file" from extension host expression "(async () => { const uri = globalThis.__unresolvedLegacyUri; const document = vscode.workspace.textDocuments.find(candidate => candidate.uri.toString() === uri?.toString()); if (!document) throw new Error('Open unresolved legacy fixture is unavailable'); const text = new TextDecoder().decode(await vscode.workspace.fs.readFile(uri)); const section = JSON.parse(text).state.sections.find(entry => entry.id === 'query_legacy_migration'); if (section?.resultJson !== globalThis.__unresolvedLegacyResultJson || section.kustoAccountPartition !== undefined || section.kustoLeaveNoTraceRevision !== undefined) throw new Error('Unresolved legacy disk payload changed before Save: ' + JSON.stringify(section)); return { payloadStable: true, bytes: text.length, markerless: true, hasResult: true, dirtyBeforeSave: document.isDirty, descriptorStillOnDisk: section.resultArtifact !== undefined }; })()"
    Then I collect JSON artifact "unresolved-legacy-first-ui" from webview expression "(async () => { if (!window.__e2e?.workbench) throw new Error('Workbench E2E bridge unavailable'); const chart = await window.__e2e.workbench.assertMigratedResultChart('query_legacy_migration', 'chart_legacy_migration', 3); const section = document.getElementById('query_legacy_migration'); const serialized = section?.serialize?.(); const table = section?.querySelector('kw-data-table'); if (!serialized?.resultJson || serialized.resultArtifact || serialized.kustoAccountPartition !== undefined || serialized.kustoLeaveNoTraceRevision !== undefined) throw new Error('Display-only legacy result gained persisted ownership: ' + JSON.stringify(serialized)); if (table?.rows?.length !== 3 || table.options?.showSave === true) throw new Error('Display-only legacy UI is incomplete: ' + JSON.stringify({ rows: table?.rows?.length, showSave: table?.options?.showSave })); section.setExpanded?.(true); await section.updateComplete; section.scrollIntoView({ block: 'start' }); return { chart, rows: table.rows.length, markerless: true, saveVisible: false }; })()"
    When I evaluate "(async () => { const chart = document.getElementById('chart_legacy_migration'); const edit = chart?.shadowRoot?.querySelector('button.mode-btn[title=Edit]'); if (!chart || !edit) throw new Error('Chart Edit control is unavailable'); edit.click(); await chart.updateComplete; const input = chart.shadowRoot?.querySelector('input.chart-title-input'); if (!input) throw new Error('Chart title input is unavailable'); input.focus(); input.select(); return 'Chart title input focused'; })()" in the webview
    When I type "Unresolved legacy saved"
