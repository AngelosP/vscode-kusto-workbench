    Then I collect JSON artifact "unresolved-legacy-reopened-file" from extension host expression "(async () => { const uri = globalThis.__unresolvedLegacyUri; const deadline = Date.now() + 10000; while (Date.now() < deadline) { const document = vscode.workspace.textDocuments.find(candidate => candidate.uri.toString() === uri?.toString()); if (document) { const text = new TextDecoder().decode(await vscode.workspace.fs.readFile(uri)); const file = JSON.parse(text); const section = file.state.sections.find(entry => entry.id === 'query_legacy_migration'); const chart = file.state.sections.find(entry => entry.id === 'chart_legacy_migration'); if (section?.resultJson === globalThis.__unresolvedLegacyResultJson && section.kustoAccountPartition === undefined && section.kustoLeaveNoTraceRevision === undefined && section.resultArtifact === undefined && chart?.chartTitle === 'Unresolved legacy saved' && chart?.mode === 'preview') return { payloadStable: true, bytes: text.length, markerless: true, chartTitle: chart.chartTitle, mode: chart.mode, dirtyAtCheck: document.isDirty }; } await new Promise(resolve => setTimeout(resolve, 100)); } throw new Error('Reopened unresolved legacy durable state did not settle'); })()"
    Then I collect JSON artifact "unresolved-legacy-reopened-ui" from webview expression "(async () => { if (!window.__e2e?.workbench) throw new Error('Workbench E2E bridge unavailable'); const chartContract = await window.__e2e.workbench.assertMigratedResultChart('query_legacy_migration', 'chart_legacy_migration', 3); const section = document.getElementById('query_legacy_migration'); const chart = document.getElementById('chart_legacy_migration'); const serialized = section?.serialize?.(); const chartState = chart?.serialize?.(); const table = section?.querySelector('kw-data-table'); if (!serialized?.resultJson || serialized.resultArtifact || serialized.kustoAccountPartition !== undefined || serialized.kustoLeaveNoTraceRevision !== undefined || table?.rows?.length !== 3 || table.options?.showSave === true || chartState?.chartTitle !== 'Unresolved legacy saved') throw new Error('Reopened display-only legacy contract failed: ' + JSON.stringify({ serialized, chartState, rows: table?.rows?.length, showSave: table?.options?.showSave })); section.setExpanded?.(true); await section.updateComplete; section.scrollIntoView({ block: 'start' }); return { chart: chartContract, rows: table.rows.length, markerless: true, saveVisible: false, chartTitle: chartState.chartTitle }; })()"
