    When I open file "tests/vscode-extension-tester/e2e/default/did-you-know-embedded-popup/fixtures/embedded-did-you-know.kqlx" in the editor
    And I wait for "kw-query-section .monaco-editor" in the webview for 25 seconds
    Then I collect JSON artifact "embedded-reset-target" from extension host expression "(async () => { const result = await vscode.commands.executeCommand('kustoWorkbench.test.resetDidYouKnowState', { openIfKustoFileOpen: true, silent: true, documentPath: 'tests/vscode-extension-tester/e2e/default/did-you-know-embedded-popup/fixtures/embedded-did-you-know.kqlx' }); if (result?.openedCompact !== true || !String(result.triggerDocumentUri || '').replace(/\\/g, '/').endsWith('/tests/vscode-extension-tester/e2e/default/did-you-know-embedded-popup/fixtures/embedded-did-you-know.kqlx')) throw new Error('Embedded reset targeted the wrong document: ' + JSON.stringify(result)); return result; })()"
    And I wait for "#kw-embedded-tutorial-viewer-host kw-tutorial-viewer" in the webview for 25 seconds
    And I evaluate "(async () => { const sleep = ms => new Promise(resolve => setTimeout(resolve, ms)); const waitFor = async predicate => { for (let attempt = 0; attempt < 160; attempt++) { const value = await predicate(); if (value) return value; await sleep(100); } throw new Error('Timed out waiting for embedded Did you know popup'); }; const host = await waitFor(() => document.querySelector('#kw-embedded-tutorial-viewer-host')); const viewer = await waitFor(() => host.querySelector('kw-tutorial-viewer')); const root = viewer.shadowRoot; await waitFor(async () => { await viewer.updateComplete; const image = root.querySelector('.compact-markdown img'); return viewer.snapshot && root.querySelector('[data-testid=tutorial-viewer-mode-compact]') && root.querySelector('[data-testid=tutorial-compact-got-it]') && image?.complete && image.naturalWidth > 0; }); const standaloneViewer = document.body.matches('kw-tutorial-viewer') || document.body.firstElementChild?.matches?.('kw-tutorial-viewer'); if (standaloneViewer) throw new Error('Did you know viewer mounted as the standalone webview body instead of the embedded overlay'); if (!document.querySelector('kw-query-section')) throw new Error('Expected to still be inside the Kusto editor webview body'); const markdown = root.querySelector('.compact-markdown'); const image = markdown?.querySelector('img'); if (!image || image.naturalWidth < 1 || !image.alt.includes('Kusto Workbench agent prompt')) throw new Error('Embedded tutorial media did not render: ' + markdown?.textContent); if (markdown.textContent.includes('![') || markdown.textContent.includes('tip-agent-schema-search.png')) throw new Error('Embedded tutorial leaked raw image Markdown: ' + markdown.textContent); const overlayRect = host.getBoundingClientRect(); if (overlayRect.width < 300 || overlayRect.height < 200) throw new Error('Embedded overlay should fill the editor webview, got ' + JSON.stringify(overlayRect.toJSON())); return { embedded: true, mode: viewer.mode, image: { alt: image.alt, width: image.naturalWidth, height: image.naturalHeight }, overlay: overlayRect.toJSON() }; })()" in the webview for 25 seconds
    When I resize the Dev Host to <width> by 720
    Then I collect JSON artifact "compact-footer-layout" from webview expression "(async () => { const viewer = document.querySelector('#kw-embedded-tutorial-viewer-host kw-tutorial-viewer'); if (!viewer) throw new Error('Embedded tutorial viewer missing'); await viewer.updateComplete; await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve))); if (innerWidth < <minViewport> || innerWidth > <maxViewport>) throw new Error('Unexpected webview width: ' + innerWidth); const root = viewer.shadowRoot; const footer = root.querySelector('.compact-footer').getBoundingClientRect(); const nav = root.querySelector('.compact-nav').getBoundingClientRect(); const ids = ['tutorial-compact-mute', 'tutorial-mode-standard', 'tutorial-compact-got-it']; const buttons = ids.map(id => { const button = root.querySelector('[data-testid=' + id + ']'); if (!button) throw new Error('Missing compact action: ' + id); return { id, ...button.getBoundingClientRect().toJSON() }; }); for (const [index, button] of buttons.entries()) { if (button.width <= 0 || button.height <= 0 || button.left < footer.left || button.right > footer.right || button.top < footer.top || button.bottom > footer.bottom) throw new Error('Compact action is outside the footer: ' + JSON.stringify(button)); if (button.left < nav.right && button.right > nav.left && button.top < nav.bottom && button.bottom > nav.top) throw new Error('Compact action overlaps navigation: ' + JSON.stringify(button)); if (index > 0 && (Math.abs(button.y + button.height / 2 - buttons[0].y - buttons[0].height / 2) > 1 || button.left < buttons[index - 1].right)) throw new Error('Compact actions should stay side by side when they fit: ' + JSON.stringify({ viewportWidth: innerWidth, footer: footer.toJSON(), buttons })); } return { viewportWidth: innerWidth, footer: footer.toJSON(), navigation: nav.toJSON(), buttons }; })()"
