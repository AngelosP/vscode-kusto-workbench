    When I evaluate "(async () => { const cm = document.querySelector('kw-connection-manager'); const root = cm?.shadowRoot; if (!cm || !root) throw new Error('Connection manager missing'); const tables = Array.from({ length: 80 }, (_, i) => 'Table_' + String(i + 1).padStart(2, '0')); const columnTypesByTable = Object.fromEntries(tables.map(t => [t, { Timestamp: 'datetime', Value: 'string' }])); const snapshot = { timestamp: Date.now(), activeKind: 'kusto', connections: [{ id: 'scroll-kusto', name: 'Scroll Cluster', clusterUrl: 'https://scroll.kusto.windows.net' }], favorites: [], cachedDatabases: { 'scroll.kusto.windows.net': ['OnlyDb'] }, expandedClusters: ['scroll-kusto'], leaveNoTraceClusters: [], sqlConnections: [], sqlCachedDatabases: {}, sqlExpandedConnections: [], sqlFavorites: [], sqlLeaveNoTrace: [] }; window.dispatchEvent(new MessageEvent('message', { data: { type: 'snapshot', snapshot } })); await cm.updateComplete; const clusterRow = [...root.querySelectorAll('.explorer-list-item')].find(item => item.textContent.includes('Scroll Cluster')); if (!clusterRow) throw new Error('Scroll Cluster row missing'); clusterRow.click(); await cm.updateComplete; const dbRow = [...root.querySelectorAll('.explorer-list-item')].find(item => item.textContent.includes('OnlyDb')); if (!dbRow) throw new Error('OnlyDb row missing before schema navigation'); dbRow.click(); window.dispatchEvent(new MessageEvent('message', { data: { type: 'schemaLoaded', connectionId: 'scroll-kusto', database: 'OnlyDb', schema: { tables, functions: [], columnTypesByTable } } })); await cm.updateComplete; const tablesRow = [...root.querySelectorAll('.explorer-list-item')].find(item => (item.querySelector('.explorer-list-item-name')?.textContent || '').trim() === 'Tables'); if (!tablesRow) throw new Error('Tables row missing'); tablesRow.click(); await cm.updateComplete; const list = root.querySelector('.explorer-list'); if (!list) throw new Error('Explorer list missing at tables level'); list.scrollTop = list.scrollHeight; if (list.scrollTop <= 0) throw new Error('Could not put tables list into a scrolled state; scrollTop=' + list.scrollTop + ', scrollHeight=' + list.scrollHeight + ', clientHeight=' + list.clientHeight); const breadcrumbItems = [...root.querySelectorAll('.explorer-breadcrumb .breadcrumb-item')]; const clusterCrumb = breadcrumbItems.find(item => item.textContent.includes('Scroll Cluster')); if (!clusterCrumb) throw new Error('Cluster breadcrumb missing'); clusterCrumb.click(); await cm.updateComplete; const afterList = root.querySelector('.explorer-list'); const afterDbRows = [...root.querySelectorAll('.explorer-list-item')].filter(item => item.querySelector('.explorer-list-item-icon.database')); if (afterDbRows.length !== 1) throw new Error('Expected one database row after breadcrumb navigation, got ' + afterDbRows.length); const viewport = afterList.getBoundingClientRect(); const rect = afterDbRows[0].getBoundingClientRect(); const visible = rect.height > 0 && rect.bottom > viewport.top && rect.top < viewport.bottom; if (!visible) throw new Error('Database row exists but is not visible after returning from scrolled table list. scrollTop=' + afterList.scrollTop + ', viewport=' + JSON.stringify({ top: viewport.top, bottom: viewport.bottom, height: viewport.height }) + ', row=' + JSON.stringify({ top: rect.top, bottom: rect.bottom, height: rect.height, text: afterDbRows[0].textContent?.trim() })); if (afterList.scrollTop !== 0) throw new Error('Database list kept stale scrollTop=' + afterList.scrollTop + ' after returning from scrolled table list'); return 'database list visible after returning from scrolled tables'; })()" in the webview

  Scenario: Connection Manager shows asynchronously loaded short database list without wheel
    When I execute command "kusto.manageConnections"
    And I wait 3 seconds
    When I wait for "kw-connection-manager" in the webview for 20 seconds

    When I evaluate "(async () => { const cm = document.querySelector('kw-connection-manager'); const root = cm?.shadowRoot; if (!cm || !root) throw new Error('Connection manager missing'); const manyConnections = Array.from({ length: 36 }, (_, i) => ({ id: 'async-kusto-' + i, name: 'Async Cluster ' + String(i).padStart(2, '0'), clusterUrl: 'https://async-' + i + '.kusto.windows.net' })); const target = manyConnections[manyConnections.length - 1]; const snapshot = { timestamp: Date.now(), activeKind: 'kusto', connections: manyConnections, favorites: [], cachedDatabases: {}, expandedClusters: [], leaveNoTraceClusters: [], sqlConnections: [], sqlCachedDatabases: {}, sqlExpandedConnections: [], sqlFavorites: [], sqlLeaveNoTrace: [] }; window.dispatchEvent(new MessageEvent('message', { data: { type: 'snapshot', snapshot } })); await cm.updateComplete; const content = root.querySelector('.explorer-content'); if (!content) throw new Error('Explorer content missing'); content.scrollTop = content.scrollHeight; if (content.scrollTop <= 0) throw new Error('Could not put root cluster list into scrolled state'); const targetRow = [...root.querySelectorAll('.explorer-list-item')].find(item => item.textContent.includes(target.name)); if (!targetRow) throw new Error('Target async cluster row missing'); targetRow.click(); await cm.updateComplete; const loading = root.querySelector('.loading-state'); if (!loading || !loading.textContent.includes('Loading databases')) throw new Error('Expected loading databases state after uncached cluster click'); const loadedSnapshot = { ...snapshot, cachedDatabases: { ['async-' + (manyConnections.length - 1) + '.kusto.windows.net']: ['OnlyAsyncDb'] }, expandedClusters: [target.id] }; window.dispatchEvent(new MessageEvent('message', { data: { type: 'snapshot', snapshot: loadedSnapshot } })); await cm.updateComplete; await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve))); await new Promise(resolve => setTimeout(resolve, 150)); const afterContent = root.querySelector('.explorer-content'); const nestedList = afterContent?.querySelector('.explorer-list'); if (!nestedList) throw new Error('Drilled database list wrapper missing'); const nestedStyle = getComputedStyle(nestedList); if (/(auto|scroll)/.test(nestedStyle.overflowY)) throw new Error('Drilled database view created a vertical scroll container inside the explorer viewport. This can keep stale hidden scroll state and blank short database lists until wheel. overflowY=' + nestedStyle.overflowY); const dbRows = [...root.querySelectorAll('.explorer-list-item')].filter(item => item.querySelector('.explorer-list-item-icon.database')); if (dbRows.length !== 1) throw new Error('Expected one async database row, got ' + dbRows.length); const viewport = afterContent.getBoundingClientRect(); const rect = dbRows[0].getBoundingClientRect(); const visible = rect.height > 0 && rect.bottom > viewport.top && rect.top < viewport.bottom; if (!visible) throw new Error('Async loaded database row exists but is not visible before wheel. content.scrollTop=' + afterContent.scrollTop + ', viewport=' + JSON.stringify({ top: viewport.top, bottom: viewport.bottom, height: viewport.height }) + ', row=' + JSON.stringify({ top: rect.top, bottom: rect.bottom, height: rect.height, text: dbRows[0].textContent?.trim() })); if (afterContent.scrollTop !== 0) throw new Error('Async database list kept stale explorer-content scrollTop=' + afterContent.scrollTop); return 'async short database list visible before wheel'; })()" in the webview
