Feature: Result grid scrollbar auto-hide

  Scenario: Fresh unscrolled results hide after idle and after pointer movement
    Given the extension is in a clean state
    When I move the Dev Host to 0, 0
    And I resize the Dev Host to 1000 by 700
    And I execute command "workbench.action.closeSidebar"
    And I execute command "workbench.action.closeAuxiliaryBar"
    And I execute command "workbench.action.closePanel"
    And I execute command "kusto.openQueryEditor"
    And I wait for "body[data-kusto-e2e-ready='true']" in the webview for 25 seconds
    And I evaluate "(async () => { await window.__e2e.workbench.clearSections(); const id = window.addQueryBox({ id: 'e2e_auto_hide_results', initialQuery: 'print example=1', expanded: true }); const columns = Array.from({ length: 12 }, (_, index) => ({ name: 'WideColumn_' + index, type: 'string' })); await window.__e2e.workbench.seedResult(id, { columns, rows: [columns.map((_, index) => 'Value_' + index)], metadata: {} }); const table = document.getElementById(id + '_results')?.querySelector('kw-data-table'); if (!table) throw new Error('Seeded result table missing'); table.scrollIntoView({ block: 'center' }); await table.updateComplete; const viewport = table.shadowRoot?.querySelector('.vscroll [data-overlayscrollbars-viewport]'); const rail = table.shadowRoot?.querySelector('.vscroll .os-scrollbar-horizontal'); if (!viewport || !rail || rail.classList.contains('os-scrollbar-unusable') || viewport.scrollWidth <= viewport.clientWidth || viewport.scrollLeft !== 0) throw new Error('Fresh unscrolled grid has no usable horizontal overflow'); await new Promise(resolve => setTimeout(resolve, 1200)); if (!rail.classList.contains('os-scrollbar-auto-hide-hidden') || getComputedStyle(rail).opacity !== '0') throw new Error('Fresh result scrollbar remained visible before any scroll'); return 'fresh-result-scrollbar-hidden'; })()" in the webview for 20 seconds
    And I evaluate "(async () => { const table = document.getElementById('e2e_auto_hide_results_results')?.querySelector('kw-data-table'); const host = table?.shadowRoot?.querySelector('.vscroll'); const rail = host?.querySelector('.os-scrollbar-horizontal'); if (!host || !rail) throw new Error('Result scrollbar missing'); const rect = host.getBoundingClientRect(); host.dispatchEvent(new PointerEvent('pointermove', { bubbles: true, pointerType: 'mouse', clientX: rect.right - 5, clientY: rect.bottom - 5 })); await new Promise(resolve => requestAnimationFrame(() => resolve())); if (rail.classList.contains('os-scrollbar-auto-hide-hidden')) throw new Error('Result scrollbar did not show on pointer movement'); document.documentElement.dataset.testResultScrollbarSeenVisible = 'true'; await new Promise(resolve => setTimeout(resolve, 1200)); if (!rail.classList.contains('os-scrollbar-auto-hide-hidden') || getComputedStyle(rail).opacity !== '0') throw new Error('Result scrollbar stayed visible without a pointerleave event'); return 'idle-result-scrollbar-hidden'; })()" in the webview for 20 seconds
    Then I collect JSON artifact "result-grid-auto-hide" from webview expression "(() => { const table = document.getElementById('e2e_auto_hide_results_results')?.querySelector('kw-data-table'); const viewport = table?.shadowRoot?.querySelector('.vscroll [data-overlayscrollbars-viewport]'); const rail = table?.shadowRoot?.querySelector('.vscroll .os-scrollbar-horizontal'); if (!table || !viewport || !rail) throw new Error('Result scrollbar missing for artifact'); return { rows: table.rows.length, columns: table.columns.length, scrollWidth: viewport.scrollWidth, clientWidth: viewport.clientWidth, scrollLeft: viewport.scrollLeft, seenVisible: document.documentElement.dataset.testResultScrollbarSeenVisible === 'true', hiddenAfterIdle: rail.classList.contains('os-scrollbar-auto-hide-hidden'), opacity: getComputedStyle(rail).opacity }; })()"
    And I execute command "workbench.action.focusActiveEditorGroup"
    And I click at 30, 400
    And I wait 2 seconds
    And I evaluate "(() => { const rail = document.getElementById('e2e_auto_hide_results_results')?.querySelector('kw-data-table')?.shadowRoot?.querySelector('.vscroll .os-scrollbar-horizontal'); if (!rail || !rail.classList.contains('os-scrollbar-auto-hide-hidden') || getComputedStyle(rail).opacity !== '0') throw new Error('Result scrollbar became visible again before capture'); return 'result-scrollbar-still-hidden'; })()" in the webview
    Then I take a screenshot "result-grid-scrollbar-hidden"