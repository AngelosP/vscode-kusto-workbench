        "id": "query_multi_result_showcase",
        "type": "query",
        "name": "Run All with three statements",
        "query": "let Runs = datatable(Service:string, DurationMs:long, Failed:bool)['checkout', 138, false, 'search', 82, false, 'export', 211, true, 'checkout', 164, false, 'search', 96, true, 'export', 187, false];\nRuns | summarize Calls = count() by Service;\nRuns | summarize AvgDurationMs = avg(DurationMs), MaxDurationMs = max(DurationMs) by Service;\nRuns | summarize Failures = countif(Failed) by Service",
