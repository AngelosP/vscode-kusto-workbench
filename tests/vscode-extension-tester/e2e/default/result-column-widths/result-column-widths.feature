    Then I collect JSON artifact "unsorted-column-widths" from webview expression "(async () => { const table = document.getElementById('query_column_widths')?.querySelector('kw-data-table'); await table?.updateComplete; const root = table?.shadowRoot; const headers = root?.querySelectorAll('th[data-column-index]'); const measurementLabel = headers?.[0]?.querySelector('.th-label'); const countryLabel = headers?.[1]?.querySelector('.th-label'); if (!measurementLabel || !countryLabel || measurementLabel.scrollWidth > measurementLabel.clientWidth || countryLabel.scrollWidth > countryLabel.clientWidth) throw new Error('An unsorted header label is clipped: ' + JSON.stringify({ measurement: { clientWidth: measurementLabel?.clientWidth, scrollWidth: measurementLabel?.scrollWidth }, country: { clientWidth: countryLabel?.clientWidth, scrollWidth: countryLabel?.scrollWidth } })); table.dataset.unsortedMeasurementWidth = String(table._columnWidths[0]); return { measurementWidth: table._columnWidths[0], countryWidth: table._columnWidths[1], measurementLabel: { clientWidth: measurementLabel.clientWidth, scrollWidth: measurementLabel.scrollWidth }, countryLabel: { clientWidth: countryLabel.clientWidth, scrollWidth: countryLabel.scrollWidth } }; })()"

