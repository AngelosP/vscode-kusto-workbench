    Then I collect JSON artifact "sorted-country-column-width" from webview expression "(async () => { const table = document.getElementById('query_column_widths')?.querySelector('kw-data-table'); await table?.updateComplete; const root = table?.shadowRoot; const header = root?.querySelectorAll('th[data-column-index]')?.[1]; const label = header?.querySelector('.th-label'); const sort = header?.querySelector('.si2'); const longest = 'Democratic Republic Of The Congo'; const cell = [...(root?.querySelectorAll('tbody td') || [])].find(candidate => candidate.textContent?.trim() === longest); const style = getComputedStyle(cell); const ruler = document.createElement('span'); Object.assign(ruler.style, { position: 'absolute', visibility: 'hidden', whiteSpace: 'pre', fontFamily: style.fontFamily, fontSize: style.fontSize, fontWeight: style.fontWeight, letterSpacing: style.letterSpacing }); ruler.textContent = longest; root.appendChild(ruler); const expectedWidth = Math.ceil(ruler.getBoundingClientRect().width + 18); ruler.remove(); const width = table?._columnWidths?.[1] || 0; const renderedWidth = header?.getBoundingClientRect().width || 0; const delta = width - expectedWidth; const renderedDelta = renderedWidth - width; if (!sort || !label || label.scrollWidth > label.clientWidth || !cell || Math.abs(delta) > 1 || Math.abs(renderedDelta) > 1) throw new Error('Sorted country column is clipped or over-allocated: ' + JSON.stringify({ sort: sort?.textContent, width, renderedWidth, expectedWidth, delta, renderedDelta, label: { clientWidth: label?.clientWidth, scrollWidth: label?.scrollWidth }, cellFound: !!cell })); return { sort: sort.textContent, width, renderedWidth, expectedWidth, delta, renderedDelta, label: { clientWidth: label.clientWidth, scrollWidth: label.scrollWidth } }; })()"
