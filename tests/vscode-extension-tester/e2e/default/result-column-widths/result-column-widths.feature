    When I evaluate "(async () => { const section = document.getElementById('query_column_widths'); const countries = ['United States', 'United Kingdom', 'Burkina Faso', 'Japan', 'Democratic Republic Of The Congo', 'Australia', 'United Kingdom', 'South Africa']; const rows = countries.map((country, index) => [null, country, { display: '[object]', full: JSON.stringify({ index, country }), isObject: true }, 'Seattle', 'Washington', '2026-08-21T08:00:00Z', 'Ready', '00000000-0000-0000-0000-000000000001', index + 10, 'West', 'Standard']); const columns = [{ name: 'Measureements', type: 'dynamic' }, { name: 'ClientCountryOrRegion', type: 'string' }, { name: 'NovaProperties', type: 'dynamic' }, { name: 'ClientCity', type: 'string' }, { name: 'ClientStateOrProvince', type: 'string' }, { name: 'Timestamp', type: 'datetime' }, { name: 'Status', type: 'string' }, { name: 'RequestId', type: 'guid' }, { name: 'DurationMs', type: 'long' }, { name: 'Region', type: 'string' }, { name: 'Category', type: 'string' }]; if (!section?.displayResult?.({ columns, rows, metadata: {} }, { label: 'Results' })) throw new Error('Synthetic column-width results were not presented'); const table = section.querySelector('kw-data-table'); await table?.updateComplete; section.scrollIntoView({ block: 'start' }); return { rows: table?.rows?.length, columns: table?.columns?.length }; })()" in the webview "column-widths.kqlx" for 10 seconds
