Feature: Kusto Copilot result bridge survives notebook reactivation

  Background:
    Given the extension is in a clean state
    And I capture the output channel "Kusto Workbench"
    When I move the Dev Host to 0, 0
    And I resize the Dev Host to 1280x1000
    When I execute command "workbench.action.closeAuxiliaryBar"

  Scenario: Direct and delegated execution apply the same 3-row by 4-column result
    When I execute command "kusto.openQueryEditor"
    And I wait 3 seconds
    When I evaluate "window.__e2e.workbench.clearSections()" in the webview
    When I click "button[data-add-kind='query']" in the webview
    When I wait for "kw-query-section[data-test-connection='true']" in the webview for 15 seconds
    When I wait for "kw-query-section[data-test-databases-loading='false'][data-test-has-databases='true']" in the webview for 30 seconds
    When I evaluate "window.__e2e.kusto.selectSampleDatabase()" in the webview
    When I wait for "kw-query-section[data-test-database-selected='true']" in the webview for 10 seconds

    When I evaluate "window.__e2e.kusto.setQuery(`range RowId from 1 to 3 step 1 | extend Category = strcat(\u0022row_  \u0022, tostring(RowId)), Count = RowId * 10, Ratio = todouble(RowId) / 3.0 | project RowId, Category, Count, Ratio`)" in the webview
    When I evaluate "window.__e2e.kusto.run()" in the webview
    When I wait for "kw-query-section[data-test-executing='false'][data-test-has-results='true']" in the webview for 120 seconds
    Then I collect JSON artifact "direct-3x4-result" from webview expression "(() => { window.__e2e.kusto.assertRowCount(3); window.__e2e.kusto.assertResultColumns('RowId,Category,Count,Ratio'); const section = document.querySelector('kw-query-section'); return { sectionId: section.boxId || section.id, rowCount: 3, columnCount: 4 }; })()"

    When I execute command "workbench.action.files.newUntitledFile"
    And I wait 1 second
  Then I collect JSON artifact "evicted-tool-session-bridge" from extension host expression "(async () => { const evicted = await vscode.commands.executeCommand('kustoWorkbench.test.evictActiveToolSessionConnection'); if (evicted !== true) throw new Error('Active Workbench tool-session connection was not evicted'); return { evicted }; })()"
    When I execute command "workbench.action.previousEditor"
    When I wait for "kw-query-section[data-test-database-selected='true']" in the webview for 15 seconds
    When I evaluate "(() => { window.__e2eKustoResultBridgeEvents = []; for (const type of ['kusto-workbench-query-started','kusto-workbench-query-terminal','kusto-workbench-copilot-done-applied']) window.addEventListener(type, event => window.__e2eKustoResultBridgeEvents.push({ type, detail: event.detail })); window.addEventListener('message', event => { if (event.data?.type === 'kustoExecutionStarted') window.__e2eKustoResultBridgeEvents.push({ type: 'raw-kusto-execution-started', detail: event.data }); }); window.__e2eKustoResultBridgePreviousCapture = window.__e2eCaptureHostMessage; window.__e2eCaptureHostMessage = message => { if (message?.type === 'kustoExecutionStartedAck') window.__e2eKustoResultBridgeEvents.push({ type: 'kusto-execution-started-ack', detail: message }); return typeof window.__e2eKustoResultBridgePreviousCapture === 'function' ? window.__e2eKustoResultBridgePreviousCapture(message) : true; }; return 'Kusto result bridge trace armed'; })()" in the webview
    When I execute command "kustoWorkbench.test.configureCopilotDevelopmentModel" with args '[[{"toolCalls":[{"callId":"kusto-3x4-final","name":"respond_to_all_other_queries","input":{"query":"range RowId from 1 to 3 step 1 | extend Category = strcat(\u0022row_  \u0022, tostring(RowId)), Count = RowId * 10, Ratio = todouble(RowId) / 3.0 | project RowId, Category, Count, Ratio"}}]}]]'

    Then I collect JSON artifact "delegated-3x4-result" from extension host expression "(async () => { const options = input => ({ toolInvocationToken: undefined, input }); const textOf = result => String(result.content.find(part => typeof part?.value === 'string')?.value || ''); const listed = JSON.parse(textOf(await vscode.lm.invokeTool('kusto-workbench_list-sections', options({})))); const section = listed.sections.find(candidate => candidate.type === 'query'); if (!section?.id) throw new Error('No live Kusto section after notebook reactivation: ' + JSON.stringify(listed)); const result = JSON.parse(textOf(await vscode.lm.invokeTool('kusto-workbench_ask-kusto-copilot', options({ sectionId: section.id, question: 'Run the exact 3-row by 4-column query.' })))); globalThis.__e2eKustoResultBridgeResponse = result; return { sectionId: section.id, result }; })()"
    Then I collect JSON artifact "delegated-3x4-event-trace" from webview expression "(() => { const events = window.__e2eKustoResultBridgeEvents || []; const ack = events.find(event => event.type === 'kusto-execution-started-ack'); const rawStart = events.find(event => event.type === 'raw-kusto-execution-started'); const admittedStart = events.find(event => event.type === 'kusto-workbench-query-started'); const terminal = events.find(event => event.type === 'kusto-workbench-query-terminal' && event.detail?.type === 'queryResult'); const done = events.find(event => event.type === 'kusto-workbench-copilot-done-applied'); const section = document.querySelector('kw-query-section'); const editor = window.queryEditors?.[section?.boxId]; const editorQuery = editor?.getValue?.() || section?.getCopilotEditorValue?.() || ''; const expectedQuery = `range RowId from 1 to 3 step 1 | extend Category = strcat(\u0022row_  \u0022, tostring(RowId)), Count = RowId * 10, Ratio = todouble(RowId) / 3.0 | project RowId, Category, Count, Ratio`; const normalize = value => String(value || '').replace(/\r\n?/g, String.fromCharCode(10)); const exactQueries = [editorQuery, rawStart?.detail?.query, admittedStart?.detail?.query, terminal?.detail?.query].every(query => normalize(query) === normalize(expectedQuery)); const snapshot = window.__e2e.copilot.snapshot('kusto'); if (ack?.detail?.accepted !== true || !rawStart || !admittedStart || !terminal || done?.detail?.ok !== true || rawStart.detail.executionId !== admittedStart.detail.executionId || rawStart.detail.executionId !== terminal.detail.executionId || rawStart.detail.copilotRequestId !== terminal.detail.copilotRequestId || !exactQueries || terminal.detail.result?.rows?.length !== 3 || terminal.detail.result?.columns?.length !== 4 || snapshot.running || snapshot.progress) throw new Error('Delegated Kusto event lifecycle was incomplete: ' + JSON.stringify({ events, editorQuery, expectedQuery, exactQueries, snapshot })); return { events, exactQueries, expectedQuery, section: { boxId: section?.boxId || section?.id || '', lifecycle: section?.getSchemaLifecycleIdentity?.() || null, connectionId: section?.getConnectionId?.() || '', database: section?.getDatabase?.() || '', query: editorQuery }, snapshot }; })()"
    Then I collect JSON artifact "delegated-3x4-assertion" from extension host expression "(() => { const result = globalThis.__e2eKustoResultBridgeResponse; const expectedQuery = `range RowId from 1 to 3 step 1 | extend Category = strcat(\u0022row_  \u0022, tostring(RowId)), Count = RowId * 10, Ratio = todouble(RowId) / 3.0 | project RowId, Category, Count, Ratio`; const names = (result?.columns || []).map(column => typeof column === 'string' ? column : column?.name); const categories = (result?.results || []).map(row => String(row?.[1]?.full ?? row?.[1]?.display ?? row?.[1] ?? '')); if (result?.success !== true || result.query !== expectedQuery || result.rowCount !== 3 || result.returnedRowCount !== 3 || names.join(',') !== 'RowId,Category,Count,Ratio' || !Array.isArray(result.results) || result.results.length !== 3 || result.results.some(row => !Array.isArray(row) || row.length !== 4) || categories.join('|') !== 'row_  1|row_  2|row_  3') throw new Error('askKustoCopilot failed to preserve and apply the exact 3x4 query after reactivation: ' + JSON.stringify({ result, expectedQuery, categories })); return { success: result.success, query: result.query, rowCount: result.rowCount, returnedRowCount: result.returnedRowCount, columns: names, resultWidths: result.results.map(row => row.length), categories }; })()"
    When I wait for "kw-query-section[data-test-executing='false'][data-test-has-results='true']" in the webview for 120 seconds
    Then I collect JSON artifact "delegated-3x4-rendered" from webview expression "(() => { window.__e2e.kusto.assertRowCount(3); window.__e2e.kusto.assertResultColumns('RowId,Category,Count,Ratio'); const snapshot = window.__e2e.copilot.snapshot('kusto'); if (snapshot.running || snapshot.progress) throw new Error('Kusto Copilot remained busy after applying the 3x4 result: ' + JSON.stringify(snapshot)); return { rowCount: 3, columnCount: 4, running: false }; })()"
    When I execute command "workbench.action.focusActiveEditorGroup"
    And I click at 30, 700
    Then I take a screenshot "01-delegated-3x4-result"

    When I evaluate "(() => { window.__e2eCaptureHostMessage = window.__e2eKustoResultBridgePreviousCapture; delete window.__e2eKustoResultBridgePreviousCapture; delete window.__e2eKustoResultBridgeEvents; return 'Kusto result bridge trace restored'; })()" in the webview
    When I execute command "kustoWorkbench.test.clearCopilotDevelopmentModel"
    When I execute command "workbench.action.closeAllEditors"
