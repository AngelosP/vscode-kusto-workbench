// Place your settings in this file to overwrite default and user settings.
{
    "files.exclude": {
        "out": false, // set this to true to hide the "out" folder with the compiled JS files
        "dist": false, // set this to true to hide the "dist" folder with the compiled JS files
        "**/.vscode-test/**": true,
        "**/.vscode-test-user-data/**": true,
        "**/.vscode-e2e/**": true,
        "**/tests/vscode-extension-tester/live/**": true,
        "**/tests/vscode-extension-tester/runs/**": true,
        "**/tests/vscode-extension-tester/results/**": true,
        "**/tests/vscode-extension-tester/history/**": true,
        "**/tests/vscode-extension-tester/profiles/**": true,
        "**/tests/vscode-extension-tester/auth-shared/**": true
    },
    "search.exclude": {
        "out": true, // set this to false to include "out" folder in search results
        "dist": true, // set this to false to include "dist" folder in search results
        "**/.vscode-test/**": true,
        "**/.vscode-test-user-data/**": true,
        "**/.vscode-e2e/**": true,
        "**/tests/vscode-extension-tester/live/**": true,
        "**/tests/vscode-extension-tester/runs/**": true,
        "**/tests/vscode-extension-tester/results/**": true,
        "**/tests/vscode-extension-tester/history/**": true,
        "**/tests/vscode-extension-tester/profiles/**": true,
        "**/tests/vscode-extension-tester/auth-shared/**": true
    },
    "files.watcherExclude": {
        "**/.vscode-test/**": true,
        "**/.vscode-test-user-data/**": true,
        "**/.vscode-e2e/**": true,
        "**/node_modules/**": true,
        "**/out/**": true,
        "**/dist/**": true,
        "**/coverage/**": true,
        "**/tests/vscode-extension-tester/live/**": true,
        "**/tests/vscode-extension-tester/runs/**": true,
        "**/tests/vscode-extension-tester/results/**": true,
        "**/tests/vscode-extension-tester/history/**": true,
        "**/tests/vscode-extension-tester/profiles/**": true,
        "**/tests/vscode-extension-tester/auth-shared/**": true
    },
    // Turn off tsc task auto detection since we have the necessary tasks as npm scripts
    "typescript.tsc.autoDetect": "off",
    "chat.tools.terminal.autoApprove": {
        "/^node esbuild-web\\.js --production 2>&1$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^node esbuild\\.js$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^node -c media/queryEditor/queryBoxes\\.js 2>&1 \\| Select-Object -First 5$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "mkdir": true,
        "vscode-ext-test": true,
        "npx vitest": true,
        "Rename-Item": true,
        "/^node esbuild\\.js --production 2>&1 \\| Select-Object -Last 5$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "Out-Null": true,
        "/^node esbuild\\.js --production 2>&1 \\| Select-Object -Last 8$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^node esbuild\\.js --production 2>&1$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "ConvertTo-Json": true,
        "npx eslint": true,
        "/^node esbuild\\.js --production$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "Test-Path": true
    }
}