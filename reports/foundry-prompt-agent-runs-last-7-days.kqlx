{
  "kind": "kqlx",
  "version": 1,
  "state": {
    "sections": [
      {
        "id": "section_b761eae3-eee5-4cbc-a4a7-35457b9a23c7",
        "type": "query",
        "name": "Daily Prompt Agent Runs — Last 7 Completed Days",
        "expanded": true,
        "resultsVisible": true,
        "clusterUrl": "https://aip-analytics-ameku.centralus.kusto.windows.net/",
        "connectionIdHint": "conn_1780427673017_ui1pl2glm",
        "database": "ingest",
        "query": "let WindowStart = startofday(ago(7d));\nlet WindowEnd = startofday(now());\nlet ExternalSubscriptions =\n    cluster(\"https://aip-analytics-ameku.centralus.kusto.windows.net/\").database(\"prod\").DimSubscription\n    | project AzSubscriptionGuid = tostring(AzSubscriptionGuid), CloudCustomerGuid\n    | join kind=inner (\n        cluster(\"https://aip-analytics-ameku.centralus.kusto.windows.net/\").database(\"prod\").DimCustomer\n        | where CustomerType == \"External\"\n        | project CloudCustomerGuid\n    ) on CloudCustomerGuid\n    | project AzSubscriptionGuid;\nlet MainPromptRuns =\n    cluster(\"https://aip-analytics-ameku.centralus.kusto.windows.net/\").database(\"ingest\").contract_Agents_AgentsV2Runs_Hourly\n    | where AgentRun_starttime >= WindowStart and AgentRun_starttime < WindowEnd\n    | where Kind == \"prompt\"\n    | project Day = startofday(AgentRun_starttime), RunKey = strcat(\"main:\", Run_id), AzSubscriptionGuid = tostring(AzSubscriptionGuid);\nlet SubAgentPromptRuns =\n    cluster(\"https://aip-analytics-ameku.centralus.kusto.windows.net/\").database(\"ingest\").contract_Agents_AgentsV2SubAgentRuns_Hourly\n    | where AgentRun_starttime >= WindowStart and AgentRun_starttime < WindowEnd\n    | where Kind == \"prompt\"\n    | project Day = startofday(AgentRun_starttime), RunKey = strcat(\"subagent:\", Run_id), AzSubscriptionGuid = tostring(AzSubscriptionGuid);\nMainPromptRuns\n| union SubAgentPromptRuns\n| join kind=inner ExternalSubscriptions on AzSubscriptionGuid\n| summarize PromptAgentRuns = count_distinct(RunKey) by Day\n| order by Day asc",
        "runMode": "plain",
        "cacheEnabled": true,
        "cacheValue": 1,
        "cacheUnit": "days",
        "copilotChatVisible": true,
        "copilotChatWidthPx": 490
      }
    ]
  }
}
